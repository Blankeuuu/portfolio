---
import type { Locale } from '@/data/site';
import { getTranslations } from '@/i18n/translations';
import { formatDate } from '@/i18n/routing';
import type { NormalizedRepository } from '@/lib/github/types';

interface Props {
  repo: NormalizedRepository;
  locale: Locale;
  index?: number;
}

const { repo, locale, index = 0 } = Astro.props;
const t = getTranslations(locale);
const languageLabel = repo.language ?? t.repos.languageFallback;
const descriptionText = repo.description ?? t.repos.noDescription;
const revealDelay = `${Math.min(index * 60, 300)}ms`;

const LANGUAGE_COLORS: Record<string, string> = {
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Python: '#3572A5',
  'C#': '#178600',
  C: '#555555',
  'C++': '#F34B7D',
  Rust: '#DEA584',
  Go: '#00ADD8',
  HTML: '#E34C26',
  CSS: '#563D7C',
  Shell: '#89E051',
};

const langColor = repo.language ? (LANGUAGE_COLORS[repo.language] ?? '#A855F7') : '#71717A';
---

<article
  data-repo-card
  data-name={repo.name.toLowerCase()}
  data-description={(repo.description ?? '').toLowerCase()}
  data-language={(repo.language ?? '').toLowerCase()}
  data-topics={repo.topics.join(' ').toLowerCase()}
  data-stars={String(repo.stargazersCount)}
  data-pushed={String(new Date(repo.pushedAt).getTime())}
  data-reveal
  style={`--reveal-delay: ${revealDelay}`}
  class="surface-card surface-card-interactive group relative flex flex-col justify-between rounded-xl p-6"
>
  <div>
    <!-- Header row: Name & Star Count -->
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="truncate text-lg font-semibold tracking-tight text-[#FAFAFA] transition-colors group-hover:text-white">
          <a
            href={repo.htmlUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t.repos.openRepoAria} ${repo.name}`}
            class="after:absolute after:inset-0 focus:outline-none"
          >
            {repo.name}
          </a>
        </h2>
      </div>

      <div
        class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-[#27272A] bg-[#18181B] px-2.5 py-1 font-mono text-xs text-[#D4D4D8]"
        aria-label={`${repo.stargazersCount} ${t.repos.starsLabel}`}
      >
        <svg
          class:list={[
            'h-3.5 w-3.5',
            repo.stargazersCount > 0 ? 'text-[#A855F7]' : 'text-[#71717A]',
          ]}
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
        <span>{repo.stargazersCount}</span>
      </div>
    </div>

    <!-- Description -->
    <p
      class:list={[
        'mt-3 text-sm leading-relaxed',
        repo.description ? 'text-[#A1A1AA]' : 'italic text-[#71717A]',
      ]}
    >
      {descriptionText}
    </p>

    <!-- Topics -->
    {
      repo.topics.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Topics">
          {repo.topics.map((topic) => (
            <li class="rounded border border-[#27272A] bg-[#09090B] px-2 py-0.5 font-mono text-[11px] text-[#A1A1AA]">
              #{topic}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <!-- Metadata Footer -->
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[#1F1F23] pt-4 text-xs text-[#A1A1AA]">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 font-mono text-xs text-[#E4E4E7]">
        <span
          class="h-2.5 w-2.5 rounded-full"
          style={`background-color: ${langColor}`}
          aria-hidden="true"
        />
        {languageLabel}
      </span>

      <span class="text-[#27272A]" aria-hidden="true">·</span>

      <span class="font-mono text-xs text-[#71717A]">
        {t.repos.lastPushLabel}:{' '}
        <time datetime={repo.pushedAt} class="text-[#A1A1AA]">
          {formatDate(repo.pushedAt, locale)}
        </time>
      </span>
    </div>

    <span
      class="inline-flex items-center gap-1 font-mono text-xs font-medium text-[#A1A1AA] transition-colors group-hover:text-[#A855F7]"
      aria-hidden="true"
    >
      {t.repos.viewOnGithub} ↗
    </span>
  </div>
</article>
