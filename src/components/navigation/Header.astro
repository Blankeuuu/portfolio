---
import type { Locale } from '@/data/site';
import { getTranslations } from '@/i18n/translations';
import {
  getCanonicalRouteKey,
  getEquivalentLocalePaths,
  getLocalizedPath,
} from '@/i18n/routing';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = Astro.url.pathname } = Astro.props;
const t = getTranslations(locale);
const base = import.meta.env.BASE_URL;

const routeKey = getCanonicalRouteKey(currentPath, base);
const localePaths = getEquivalentLocalePaths(currentPath, base);

const navItems = [
  { key: '/', label: t.nav.home, href: getLocalizedPath('/', locale, base) },
  { key: '/repos/', label: t.nav.repos, href: getLocalizedPath('/repos/', locale, base) },
  { key: '/models/', label: t.nav.models, href: getLocalizedPath('/models/', locale, base) },
  { key: '/about/', label: t.nav.about, href: getLocalizedPath('/about/', locale, base) },
];

function isItemActive(itemKey: string, currentKey: string): boolean {
  if (itemKey === '/') {
    return currentKey === '/';
  }
  return currentKey === itemKey || currentKey.startsWith(itemKey);
}
---

<header
  class="sticky top-0 z-50 w-full border-b border-[#27272A]/80 bg-[#09090B]/85 backdrop-blur-md transition-colors"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Identity -->
    <a
      href={getLocalizedPath('/', locale, base)}
      class="group inline-flex items-center gap-2.5 text-sm font-medium tracking-tight text-[#FAFAFA] transition-colors hover:text-white"
    >
      <span
        class="inline-flex h-2 w-2 rounded-full bg-[#A855F7] ring-4 ring-[#A855F7]/15 transition-transform duration-300 group-hover:scale-125"
        aria-hidden="true"></span>
      <span class="font-semibold tracking-tight">Szymon Potyra</span>
      <span
        class="hidden rounded border border-[#27272A] bg-[#111115] px-1.5 py-0.5 font-mono text-[11px] font-normal text-[#A1A1AA] sm:inline-block"
      >
        Maker
      </span>
    </a>

    <!-- Desktop Primary Navigation -->
    <nav aria-label={t.nav.mainNavAria} class="hidden md:flex md:items-center md:gap-1">
      {
        navItems.map((item) => {
          const active = isItemActive(item.key, routeKey);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative rounded-md px-3.5 py-1.5 text-sm transition-colors duration-200',
                active
                  ? 'bg-[#18181B] font-medium text-[#FAFAFA] shadow-[inset_0_1px_0_0_rgba(168,85,247,0.35)]'
                  : 'text-[#A1A1AA] hover:bg-[#111115] hover:text-[#FAFAFA]',
              ]}
            >
              {item.label}
              {active && (
                <span
                  class="absolute inset-x-3 -bottom-[13px] h-[2px] rounded-full bg-[#A855F7]"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Language Switcher + Mobile Menu Trigger -->
    <div class="flex items-center gap-2.5">
      <div
        role="group"
        aria-label={t.nav.languageSwitchAria}
        class="inline-flex items-center rounded-md border border-[#27272A] bg-[#111115] p-0.5 font-mono text-xs"
      >
        <a
          href={localePaths.en}
          data-lang-switch="en"
          aria-label={t.nav.switchToEnglish}
          aria-current={locale === 'en' ? 'true' : undefined}
          class:list={[
            'rounded px-2 py-1 transition-colors duration-150',
            locale === 'en'
              ? 'bg-[#18181B] font-medium text-[#FAFAFA] ring-1 ring-[#A855F7]/40'
              : 'text-[#A1A1AA] hover:text-[#FAFAFA]',
          ]}
        >
          EN
        </a>
        <a
          href={localePaths.pl}
          data-lang-switch="pl"
          aria-label={t.nav.switchToPolish}
          aria-current={locale === 'pl' ? 'true' : undefined}
          class:list={[
            'rounded px-2 py-1 transition-colors duration-150',
            locale === 'pl'
              ? 'bg-[#18181B] font-medium text-[#FAFAFA] ring-1 ring-[#A855F7]/40'
              : 'text-[#A1A1AA] hover:text-[#FAFAFA]',
          ]}
        >
          PL
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label={t.nav.mobileMenuOpen}
        data-open-label={t.nav.mobileMenuOpen}
        data-close-label={t.nav.mobileMenuClose}
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[#27272A] bg-[#111115] text-[#A1A1AA] transition-colors hover:border-[#3F3F46] hover:text-[#FAFAFA] md:hidden"
      >
        <svg
          id="mobile-icon-open"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg
          id="mobile-icon-close"
          class="hidden h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu-panel"
    class="hidden border-t border-[#27272A] bg-[#09090B]/95 backdrop-blur-lg md:hidden"
  >
    <nav aria-label={t.nav.mainNavAria} class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {
        navItems.map((item) => {
          const active = isItemActive(item.key, routeKey);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between rounded-md px-3 py-2.5 text-sm transition-colors',
                active
                  ? 'border border-[#A855F7]/30 bg-[#18181B] font-medium text-[#FAFAFA]'
                  : 'text-[#A1A1AA] hover:bg-[#111115] hover:text-[#FAFAFA]',
              ]}
            >
              <span>{item.label}</span>
              {active && (
                <span class="h-1.5 w-1.5 rounded-full bg-[#A855F7]" aria-hidden="true" />
              )}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
